post_install() {
  cat <<'EOF'
KDE dotfiles were installed.

Apply the user configuration after logging in to Plasma:
  clipsneko-kde-configure

For an unattended layout reset:
  clipsneko-kde-configure --yes

The package does not enable services. Enable SDDM when the system is ready:
  sudo systemctl enable sddm.service
EOF
}

post_upgrade() {
  post_install
}
